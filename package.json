{
  "name": "@mcp-z/email",
  "version": "1.1.3",
  "description": "Email processing toolkit with base schemas, normalization utilities, and shared constants for Gmail/Outlook integration",
  "keywords": [
    "email",
    "email-parser",
    "email-query",
    "email-filter",
    "email-normalization",
    "gmail",
    "outlook",
    "microsoft-graph",
    "google-api",
    "typescript",
    "zod",
    "email-validation",
    "address-parser",
    "email-search",
    "email-processing",
    "message-filter",
    "dsl",
    "query-parser",
    "query-language",
    "mongodb-query",
    "email-client",
    "multi-provider",
    "email-integration"
  ],
  "homepage": "https://github.com/mcp-z/email#readme",
  "bugs": {
    "url": "https://github.com/mcp-z/email/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-z/email.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff.info@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsds build",
    "format": "tsds format",
    "lint": "biome check .",
    "prepublish:check": "ncp",
    "prepublishOnly": "node scripts/require-dist-tag.cjs && tsds validate",
    "test": "tsds test:node --require test/lib/env-loader.ts --no-timeouts",
    "test:ci": "tsds test:node --require test/lib/env-loader.ts --no-timeouts",
    "test:ci:engines": "nvu engines tsds test:node --require test/lib/env-loader.ts --no-timeouts",
    "test:engines": "nvu engines tsds test:node --require test/lib/env-loader.ts --no-timeouts",
    "version": "tsds version"
  },
  "dependencies": {
    "node-html-parser": "^9.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "node-version-use": "^2.4.7",
    "ts-dev-stack": "^1.22.1",
    "tsds-config": "^1.0.4",
    "tsds-lib": "^1.22.6"
  },
  "engines": {
    "node": ">=16"
  },
  "tsds": {
    "source": "src/index.ts"
  }
}
